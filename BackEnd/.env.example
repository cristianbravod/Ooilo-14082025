# ==================================
# Environment Variables Template
# ==================================
# Copy this file to .env and fill in the values.

# --- Server Configuration ---
# Environment mode: development, production, test
NODE_ENV=development

# Port for the server to listen on
PORT=3000

# --- CORS Configuration ---
# Comma-separated list of allowed client origins.
# No spaces between commas.
# Example: http://localhost:8080,http://192.168.1.10,capacitor://localhost
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,capacitor://localhost

# --- Database Configuration ---
# Full connection string for PostgreSQL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/restaurant_db"

# --- JWT Configuration ---
# Secret key for signing JSON Web Tokens. Should be a long, random string.
JWT_SECRET="YOUR_SUPER_SECRET_JWT_KEY"
JWT_EXPIRES_IN="1d"
